# Существующие значения prod .env менять не требуется. Здесь только пример.
PORT=3235
CLIENT_URL=https://example-client.ru
FREEZE_MASTER=https://example-freeze.ru
MEDTAXI_URL=https://medtaxi-evp.ru

# Опционально: дополнительные origins только для /api/call-clicks через запятую.
# В development http://localhost:3000 и http://127.0.0.1:3000 разрешены автоматически.
# Для production задайте NODE_ENV=production при запуске процесса.
CALL_CLICK_ALLOWED_ORIGINS=

# Этот же бот отправляет заявки /api/feedback и ведёт форму аналитики MedTaxi.
FREEZE_MASTER_TELEGRAM_TOKEN=
FREEZE_MASTER_CHAT_ID=

# Случайная строка A-Z, a-z, 0-9, _ и - для проверки Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=
# Опциональный allowlist Telegram user ID операторов через запятую.
# Если пусто, доступ имеют все участники FREEZE_MASTER_CHAT_ID.
TELEGRAM_OPERATOR_IDS=
# Публичный HTTPS origin backend, используется только командой регистрации webhook.
PUBLIC_BACKEND_URL=https://api.example.ru
